rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myMemberId() {
      return "gmail_" + request.auth.uid;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groupMembers/$(groupId + "__" + myMemberId()));
    }

    function isGroupAdmin(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/groupMembers/$(groupId + "__" + myMemberId())).data.role == "admin";
    }

    function canGroupEdit(groupId) {
      return signedIn()
        && (
          isGroupAdmin(groupId)
          || get(/databases/$(database)/documents/groupMembers/$(groupId + "__" + myMemberId())).data.canEdit == true
        );
    }

    match /groupFinance/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create, update: if canGroupEdit(groupId);
      allow delete: if isGroupAdmin(groupId);
    }

    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if signedIn()
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.id == groupId;
      allow update: if isGroupAdmin(groupId);
      allow delete: if isGroupAdmin(groupId);
    }

    match /groupMembers/{memberDocId} {
      allow read: if signedIn()
        && (
          resource.data.memberId == myMemberId()
          || isGroupMember(resource.data.groupId)
        );

      allow create: if signedIn()
        && request.resource.data.memberId == myMemberId()
        && (
          isGroupAdmin(request.resource.data.groupId)
          || request.resource.data.role == "viewer"
        );

      allow update: if signedIn()
        && (
          resource.data.memberId == myMemberId()
          || isGroupAdmin(resource.data.groupId)
        );

      allow delete: if signedIn()
        && (
          resource.data.memberId == myMemberId()
          || isGroupAdmin(resource.data.groupId)
        );
    }

    match /invitations/{token} {
      allow read: if signedIn()
        && (
          isGroupAdmin(resource.data.groupId)
          || request.auth.token.email == resource.data.email
        );
      allow create: if signedIn() && isGroupAdmin(request.resource.data.groupId);
      allow update: if signedIn()
        && (
          isGroupAdmin(resource.data.groupId)
          || request.auth.token.email == resource.data.email
        );
      allow delete: if signedIn() && isGroupAdmin(resource.data.groupId);
    }

    match /accessRequests/{requestId} {
      allow read: if signedIn() && isGroupMember(resource.data.groupId);
      allow create: if signedIn()
        && request.resource.data.fromMemberId == myMemberId()
        && isGroupMember(request.resource.data.groupId);
      allow update: if signedIn() && isGroupAdmin(resource.data.groupId);
      allow delete: if signedIn()
        && (
          isGroupAdmin(resource.data.groupId)
          || resource.data.fromMemberId == myMemberId()
        );
    }

    match /groupUsers/{username} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.memberId == myMemberId();
      allow update: if signedIn()
        && (
          request.resource.data.memberId == myMemberId()
          || resource.data.memberId == myMemberId()
        );
      allow delete: if signedIn() && resource.data.memberId == myMemberId();
    }

    match /userFinance/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
